# Copy this file to .env and fill in your own values. NEVER commit .env.

# RPC endpoint for the Sepolia testnet (get a free one from Alchemy or Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Private key of the wallet you'll deploy from (MetaMask > Account Details > Export Private Key)
# Use a throwaway/test wallet only. Fund it with Sepolia testnet ETH from a faucet.
PRIVATE_KEY=your_wallet_private_key_here

# Optional: for contract verification on Sepolia Etherscan
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Pinata keys for IPFS uploads (from app.pinata.cloud > API Keys)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_API_SECRET=your_pinata_api_secret_here

# Filled in after running the mint/upload script — used by the frontend
DEPLOYED_CONTRACT_ADDRESS=
